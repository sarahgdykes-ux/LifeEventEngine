# Offline deterministic mode is the default. Choose openai, gemini, or anthropic for live generation.
LLM_PROVIDER=mock

# Required for the matching provider selected above.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
